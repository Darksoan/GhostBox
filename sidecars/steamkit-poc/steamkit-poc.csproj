<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SteamKitPoc</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- O fork em `sidecars/depotdownloader-mod` não está no repo. Enquanto ele
       não voltar, o build compila contra o DepotDownloaderMod.dll guardado em
       `lib/` e declara as dependências que o fork trazia por transitividade
       (versões lidas de DepotDownloaderMod.deps.json). Se a pasta do fork
       reaparecer, o ProjectReference volta a valer sozinho. -->
  <PropertyGroup>
    <DepotDownloaderModProject>..\depotdownloader-mod\DepotDownloader\DepotDownloaderMod.csproj</DepotDownloaderModProject>
    <HasDepotDownloaderModSource>false</HasDepotDownloaderModSource>
    <HasDepotDownloaderModSource Condition="Exists('$(DepotDownloaderModProject)')">true</HasDepotDownloaderModSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasDepotDownloaderModSource)' == 'true'">
    <ProjectReference Include="$(DepotDownloaderModProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(HasDepotDownloaderModSource)' != 'true'">
    <Reference Include="DepotDownloaderMod">
      <HintPath>lib\DepotDownloaderMod.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="SteamKit2" Version="3.2.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.4" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
