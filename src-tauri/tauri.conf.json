{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PirateBox",
  "version": "0.1.1",
  "identifier": "com.piratebox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PirateBox",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ludusavi"
    ],
    "icon": [
      "../Icons/app-icon-32.png",
      "../Icons/app-icon-128.png",
      "../Icons/app-icon-256.png",
      "../Icons/app-icon.ico"
    ]
  }
}
