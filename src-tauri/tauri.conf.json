{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostBox",
  "version": "0.1.6",
  "identifier": "com.ghostbox.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostBox",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#0a0a0a",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost https: blob: data:; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "binaries/gbe_fork/**/*",
      "icons/desktopicon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "installerHooks": "./installer/hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/ludusavi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQzU0N0RGQjI1NDNGMDkKUldRSlAxU3kzMGZGL0xleFloQXhNZ2swZkt2aDlMK3JDK1dTMXEvNXZTdm5RZmh6cm55cUo1dVIK",
      "endpoints": [
        "https://ghostbox-feedback.hella.workers.dev/updates/latest"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
