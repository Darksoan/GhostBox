{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostBox",
  "version": "0.1.4",
  "identifier": "com.ghostbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostBox",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0b0b0b",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-smooth-scrolling"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    },
    "externalBin": [
      "binaries/ludusavi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQzU0N0RGQjI1NDNGMDkKUldRSlAxU3kzMGZGL0xleFloQXhNZ2swZkt2aDlMK3JDK1dTMXEvNXZTdm5RZmh6cm55cUo1dVIK",
      "endpoints": [
        "https://ghostbox-feedback.hella.workers.dev/updates/latest"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
